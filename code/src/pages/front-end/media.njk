{% extends "layouts/front-end/base.njk" %}
{% set page = "media" %}

{% block title %}Sur les médias{% endblock %}

{% block main %}
    <section class="mb-8 mt-10">
        <h1 class="text-4xl font-bold max-w-3xl">Les actualités et les évènements importants du BUT et de l'IUT CY Paris Université dans les médias</h1>
    </section>

        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        <div class="flex flex-col gap-2">
            <h2 class="text-base md:text-lg text-[#4F4F4F]">La nouvelle réforme : le BUT MMI</h2>
            <iframe class="w-full h-auto aspect-video rounded-lg" src="https://www.youtube.com/embed/oiEbQF7qfBU?si=wQSjPCnIMV8tLyIi" title="La nouvelle réforme : le BUT MMI" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>

        <div class="flex flex-col gap-2">
            <h2 class="text-base md:text-lg text-[#4F4F4F]">Pourquoi étudier à l'IUT CYU ?</h2>
            <iframe class="w-full h-auto aspect-video rounded-lg" src="https://www.youtube.com/embed/SyjF4h2Zb7Q?si=LHTX9Cum522bf9Z1" title="Pourquoi étudier à l'IUT CYU ?" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>

        <div class="flex flex-col gap-2">
            <h2 class="text-base md:text-lg text-[#4F4F4F]">Job interview en anglais au département MMI</h2>
            <iframe class="w-full h-auto aspect-video rounded-lg" src="https://www.youtube.com/embed/t72pdxpNjyc?si=gFlHeObWN8PiR5Cr" title="Job interview en anglais au département MMI" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>

        <div class="flex flex-col gap-2">
            <h2 class="text-base md:text-lg text-[#4F4F4F]">L'importance de l'IUT dans les études supérieures</h2>
            <iframe class="w-full h-auto aspect-video rounded-lg" src="https://www.youtube.com/embed/xD4wshE0hEg?si=iRV80ZmAYG0DfMMK" title="L'importance de l'IUT dans les études supérieures" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
    </section>

{% endblock %}